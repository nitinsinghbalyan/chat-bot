# Anthropic API key (or run `ant auth login`)
ANTHROPIC_API_KEY=
# Claude model: claude-sonnet-5-5 (default), claude-opus-5-5, claude-haiku-5-5
BOT_MODEL=claude-sonnet-5-5
# low | medium | high
BOT_EFFORT=low
# Server-side refusal fallback (Claude API only). Set to false on Bedrock/Vertex/Foundry.
BOT_FALLBACKS=true
PORT=3000
# Extra origins allowed to embed any seller's widget (each seller's own site goes in seller.json)
ALLOWED_ORIGINS=
# Crawl the sitemap into kb/catalogue.json on boot, and every N hours (0 = never)
CRAWL_ON_START=false
CRAWL_INTERVAL_HOURS=24
# Demo OTP (no SMS is sent)
DEMO_OTP=12345
# Where the SQLite database (chatbot.db) and the refreshed catalogue are stored. Default: ./data
DATA_DIR=
# Password for /admin/leads (HTTP Basic auth, any username; at least 8 characters). Leave empty to disable.
ADMIN_PASSWORD=
# Folder with one sub-folder per seller (default: kb/sellers)
SELLERS_DIR=

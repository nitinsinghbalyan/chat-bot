{
  "name": "seller-enquiry-chatbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Embeddable chatbot that answers buyer enquiries on behalf of a seller, grounded in the seller's KB and guardrails.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "crawl": "tsx scripts/crawl.ts",
    "eval": "tsx scripts/eval.ts",
    "kb:check": "tsx scripts/kb-check.ts",
    "retrieval:eval": "tsx scripts/retrieval-eval.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@langfuse/client": "^6.0.0",
    "@langfuse/otel": "^6.0.0",
    "@langfuse/tracing": "^6.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/otlp-exporter-base": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "minisearch": "^7.2.0",
    "read-excel-file": "9.3.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}

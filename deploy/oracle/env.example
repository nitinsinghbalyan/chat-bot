# /etc/seller-assistants.env: the server's settings (setup.sh writes it; chmod 600, owned by root).
# Edit with: sudo nano /etc/seller-assistants.env   then: sudo systemctl restart seller-assistants

# The address the bot is served on. setup.sh fills in <your-ip>.sslip.io; put your own domain here later
# (and run setup.sh again so Caddy gets its HTTPS certificate).
SITE_HOST=

# Secrets (same as on Render).
ANTHROPIC_API_KEY=
ADMIN_PASSWORD=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Same as render.yaml.
NODE_ENV=production
DATA_DIR=/var/data
PORT=3000
BOT_MODEL=claude-sonnet-5-5
BOT_EFFORT=low
CRAWL_ON_START=true
CRAWL_INTERVAL_HOURS=24

# Caddy runs on this server, so trust only it for the buyer's IP (rate limits).
TRUST_PROXY=loopback
